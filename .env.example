DATABASE_URL=postgresql://plexus:plexus@localhost:5432/plexus
NATS_URL=nats://localhost:4222
# Optional — infra/docker-compose.yml's local NATS has no auth configured,
# so these are unused in normal dev. They exist for brokers that do require
# auth (e.g. the testcontainers-provisioned NATS used in integration tests).
NATS_USER=
NATS_PASS=
PORT=3000
# Object storage (infra/docker-compose.yml's local MinIO). Used by both
# apps/orchestrator (presigning uploads/downloads) and the Go worker
# (downloading a step's input object, uploading its output object) — see
# docs/tasks/TASK-presigned-upload.md. MINIO_ENDPOINT must be reachable from
# whatever issues the presigned request (today: curl/tests on the host,
# the browser via apps/web's Apply-to-Batch flow) — see D-41 in
# docs/90-deferred-register.md.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=plexus
MINIO_SECRET_KEY=plexus-minio
MINIO_BUCKET=plexus
MINIO_USE_SSL=false
# Optional — addressing style for the S3-compatible endpoint. Unset/"true"
# (default) is path-style, matching self-hosted MinIO above. Set "false" for
# virtual-host-only endpoints (e.g. Railway's managed Bucket in production —
# see docs/tasks/TASK-deploy-railway.md).
MINIO_PATH_STYLE=true
# Optional — comma-separated allow-list of origins apps/orchestrator's CORS
# policy accepts (apps/orchestrator/src/cors.ts). Unset reflects any request
# origin, safe only because no auth exists yet — see D-42 in
# docs/90-deferred-register.md.
CORS_ORIGIN=
# Go worker: local filesystem directory processors read/write temp files
# through on their way to/from object storage (staging area, not durable
# storage — see D-11 in docs/90-deferred-register.md, resolved).
WORKER_STORAGE_DIR=./data/worker-output
# Go render server (workers/cmd/renderserver): synchronous single-image
# "editor export" path, distinct from the async NATS job-dispatch path
# above. RENDER_SERVER_ADDR is what the Go binary itself listens on;
# RENDER_SERVER_URL is what apps/orchestrator's export controller uses to
# reach it — see docs/tasks/TASK-editor-export.md.
RENDER_SERVER_ADDR=:8090
RENDER_SERVER_URL=http://localhost:8090
