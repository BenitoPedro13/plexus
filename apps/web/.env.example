# Base URL of apps/orchestrator's API, used by src/lib/editor/export.ts to
# POST /export. Next.js only loads env files from this app's own directory
# (apps/web/.env.local), not the monorepo root's .env.example (infra-only:
# orchestrator/worker vars) -- see docs/tasks/TASK-editor-export.md.
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:3000

# Canonical site URL used for metadataBase, absolute OG/Twitter image URLs, robots.txt's
# Sitemap: line, and sitemap.xml entries. Optional -- defaults to the production domain
# (src/lib/site.ts) if unset, so this only needs setting to preview those absolute URLs
# against something other than production -- see docs/tasks/TASK-seo-og-metadata.md and
# docs/90-deferred-register.md.
# NEXT_PUBLIC_SITE_URL=https://plexus.up.railway.app
